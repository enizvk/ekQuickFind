<?xml version="1.0" encoding="utf-8"?>
<!-- Search history stays on the device by default. EkBackupAgent adds it back only when the user opts in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="ekquickfind.db" />
        <exclude domain="database" path="ekquickfind.db-wal" />
        <exclude domain="database" path="ekquickfind.db-shm" />
        <exclude domain="sharedpref" path="permissions.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="ekquickfind.db" />
        <exclude domain="database" path="ekquickfind.db-wal" />
        <exclude domain="database" path="ekquickfind.db-shm" />
        <exclude domain="sharedpref" path="permissions.xml" />
    </device-transfer>
</data-extraction-rules>
